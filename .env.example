# Copy to .env and fill in. `npm start` loads .env automatically. Never commit .env.
# Replace expenses.example.co.uk with your real domain everywhere below.

# ── Server ──
PORT=3000
# Loopback only: the app is reachable from outside solely through the Cloudflare Tunnel.
HOST=127.0.0.1
# Where the SQLite database and its dated backups live. Put this on a disk that is backed up.
DATA_DIR=C:\KomfortExpenses\data
# At least 32 random characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# ── Microsoft Entra sign-in ──
MICROSOFT_TENANT_ID=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_REDIRECT_URI=https://expenses.example.co.uk/api/auth/microsoft/callback

# ── Email (links in notification emails point here) ──
APP_URL=https://expenses.example.co.uk
# Microsoft Graph sending (copy these from the current Render environment if set there)
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
GRAPH_SENDER=
# …or SMTP instead of Graph
# SMTP_HOST=smtp.office365.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# MAIL_FROM=
# Submitted expense claims are also emailed here (default purchaseinvoices@komfort.co.uk; leave empty to turn off)
# SUBMISSION_NOTIFY_EMAIL=purchaseinvoices@komfort.co.uk

# ── Break-glass admin sign-in (initial set-up / recovery only) ──
# When true, http://localhost:3000/admin offers a password sign-in for ONE account, and only
# from the server machine itself; through the tunnel it is a 404. Set back to false afterwards.
ADMIN_LOGIN_ENABLED=false
ADMIN_LOGIN_USERNAME=admin
# Remote access to /admin (e.g. on Render, where you can't sit at the server): set a long random
# key, enter it on the page with the admin password, then DELETE it once accounts are linked.
#   node -e "console.log(require('crypto').randomBytes(36).toString('base64url'))"
# ADMIN_SETUP_KEY=

# Which proxies may report the visitor IP. Defaults: 'loopback' (Cloudflare Tunnel), or all proxies on Render.
# TRUST_PROXY=
